graph TB
    %% 交互层
    subgraph "交互层 (Interaction Layer)"
        A[chat界面]
        B[虚拟电脑界面]
    end
    
    %% 应用层
    subgraph "应用层 (Application Layer)"
        C[Xxx agent]
    end

    %% 持久化层
    subgraph "Context层"
        E[root]
        F[session1]
        G[session2]
        H[file1]
    end
    
    %% MCP VPC
    subgraph "MCP Container Server"
        J[Container-Server]
        L["/mnt"]
    end
    
    subgraph "MCP Container"
        M["/mnt"]
        K[Container]
    end

    %% 连接关系
    A -->|add| C
    B -->|/mcp| J
    C -->|add| E
    E --> F
    E --> G
    F --> H
    E -->|filesystem gateway| L
    L -->|VOLUMES| M
    M --> K
    J --> |init| K
    
    %% 样式
    classDef interactionLayer fill:#e1f5fe
    classDef applicationLayer fill:#f3e5f5
    classDef contextLayer fill:#e8f5e8
    classDef persistentLayer fill:#fff3e0
    classDef mcpVpc fill:#fce4ec
    
    class A,B interactionLayer
    class C applicationLayer
    class D contextLayer
    class E,F,G,H,I persistentLayer
    class J,K,L,M mcpVpc
